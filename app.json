{
  "expo": {
    "name": "Compatikink",
    "slug": "compatikink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "compatikink",
    "newArchEnabled": true,
    "experiments": {
      "baseUrl": "/compatikink"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c0a09"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.compatikink.app",
      "associatedDomains": [
        "applinks:m1976cl-web.github.io"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c0a09"
      },
      "package": "com.compatikink.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "m1976cl-web.github.io",
              "pathPrefix": "/compatikink"
            },
            {
              "scheme": "compatikink"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite autenticarte de forma segura en tu Bóveda Privada CompatKink."
        }
      ]
    ]
  }
}
